{
  "name": "p2p_video_data-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/dev/p2p_video_data"],
      "exclude": []
    }
  },
  "bypass_actors": [],
